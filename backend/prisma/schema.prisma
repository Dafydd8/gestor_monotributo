// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int       @id @default(autoincrement())
  cuit                String    @unique
  full_name           String
  password_hash       String
  current_category_id Int?

  current_category    Category? @relation(fields: [current_category_id], references: [id])
  invoices            Invoice[]
}

model Invoice {
  id             Int      @id @default(autoincrement())
  user_id        Int
  invoice_type   String
  point_of_sale  String
  invoice_number String
  invoice_date   DateTime
  total_amount   Float
  client_name    String?   // 👈 nuevo
  client_cuit    String?   // 👈 nuevo

  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, invoice_type, point_of_sale, invoice_number])
}

model Category {
  id                       Int       @id @default(autoincrement())
  code                     String
  description              String?
  max_annual_income        Float
  max_unit_price           Float?
  max_surface_m2           Float?
  max_electric_consumption Float?
  max_rent_amount          Float?
  is_active                Boolean   @default(true)
  effective_from           DateTime
  effective_to             DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  users                    User[]

  @@unique([code, effective_from])
}