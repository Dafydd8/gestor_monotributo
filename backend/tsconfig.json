{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "ignoreDeprecations": "5.0"
  },
  "include": ["src"]
}